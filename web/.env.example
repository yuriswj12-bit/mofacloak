# Copy to .env; never commit .env or put secrets in VITE_* variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=8788
PUBLIC_ORIGIN=http://127.0.0.1:4173
DATABASE_PATH=data/portal.sqlite
TRUST_PROXY=false

# Keep false until a real gateway, wallet, prices and delivery process are ready.
PAYMENTS_ENABLED=false
GMPAY_BASE_URL=
GMPAY_PID=
GMPAY_SECRET_KEY=
PAYMENT_CATALOG_FILE=config/payment-catalog.json
# Only USDT / BSC. Adapter discovers the gateway's binance/bsc network key.

# Optional cloud Postgres storage. Keep database credentials server-side.
DATABASE_PROVIDER=sqlite
SUPABASE_DATABASE_URL=
DATABASE_CA_FILE=config/supabase-ca.crt

# Personal Binance UID payments require manual verification, not merchant API.
BINANCE_UID_ENABLED=false
BINANCE_RECEIVE_UID=
