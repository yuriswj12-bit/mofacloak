NODE_ENV=production
HOST=127.0.0.1
PORT=8788
PUBLIC_ORIGIN=https://cloak.narraops.xyz
DATABASE_PATH=/app/data/portal.sqlite
TRUST_PROXY=true
PAYMENTS_ENABLED=false
GMPAY_BASE_URL=https://cloak-pay.narraops.xyz
GMPAY_PID=
GMPAY_SECRET_KEY=
PAYMENT_CATALOG_FILE=/app/config/payment-catalog.json
QUOTE_RATE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api@latest/v1/currencies/cny.json

# Optional: bind BSC cashier and notifications to your own public receiving wallet.
GMPAY_RECEIVE_ADDRESS=

# Optional cloud Postgres storage. Keep database credentials server-side.
DATABASE_PROVIDER=sqlite
SUPABASE_DATABASE_URL=
DATABASE_CA_FILE=config/supabase-ca.crt

# Personal Binance UID payments require manual verification, not merchant API.
BINANCE_UID_ENABLED=false
BINANCE_RECEIVE_UID=
